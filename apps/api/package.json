{
  "name": "@calley/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@calley/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@lucia-auth/adapter-drizzle": "^1.1.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "arctic": "^3.7.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "ioredis": "^6.0.0",
    "isomorphic-dompurify": "3.22.0",
    "lucia": "^3.2.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "resend": "^6.21.0",
    "rrule": "^2.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
